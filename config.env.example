# Environment Mode
NODE_ENV=development

# Server Port (Default is 5000 if not set; note client proxy is set to 5001 or 5000)
PORT=5000

# MongoDB Connection String
DATABASE=mongodb://localhost:27017/visitrace_emirateslogisticstracker

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=90d

# Email / Nodemailer Configuration
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_email_username
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=no-reply@emirateslogistics.com
